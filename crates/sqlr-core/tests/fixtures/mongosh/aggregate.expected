                                        (
                                            "$gte",
                                            DateTime(
                                                1388534400000,
                                            ),
                                        ),
                                        (
                                            "$lt",
                                            DateTime(
                                                1420070400000,
                                            ),
                                        ),
                                    ],
                                ),
                            ),
                        ],
                    ),
                ),
            ],
        ),
        Document(
            [
                (
                    "$group",
